go 1.25.0

// The CLI is developed against the sdk/ module in this repository rather than
// the version pinned in go.mod, so a change to both lands in one commit and
// needs no tag in between. Once the CLI pins the sdk module, release builds
// will set GOWORK=off so the binary comes from the pinned version, exactly as
// `go install` builds it (see RELEASING.md).
use (
	.
	./sdk
)
