go 1.25.0

// The CLI is developed against the sdk/ module in this repository rather than
// the version pinned in go.mod, so a change to both lands in one commit and
// needs no tag in between. The release workflow and CI set GOWORK=off so they
// compile the version pinned in go.mod instead, which is what `go install` of
// that tag resolves (see RELEASING.md).
use (
	.
	./sdk
)
